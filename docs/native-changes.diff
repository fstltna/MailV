diff --git a/NCT_Projects/SM_NCT/SM/NCTCompat.h b/NCT_Projects/SM_NCT/SM/NCTCompat.h
new file mode 100644
index 0000000..a25ad51
--- /dev/null
+++ b/NCT_Projects/SM_NCT/SM/NCTCompat.h
@@ -0,0 +1,46 @@
+/*------------------------------------------------------------------------------
+	NCTCompat.h  (2026)
+	Fallbacks for macros that MailV's original build environment provided
+	but the NewtonDev NCT headers do not. Each is defined only if missing.
+------------------------------------------------------------------------------*/
+
+#ifndef __NCTCOMPAT_H
+#define __NCTCOMPAT_H
+
+#ifndef kVariableLengthArray
+#define kVariableLengthArray 1
+#endif
+
+#ifndef MAKEINT
+#define MAKEINT(i)		(((long) (i)) << 2)
+#endif
+
+#ifndef MAKEPTR
+#define MAKEPTR(p)		((Ref)((char *)(p) + 1))
+#endif
+
+#ifndef RPTR
+#define RPTR(p)			((char *)((Ref)(p) & ~3L))
+#endif
+
+#ifndef ISREALPTR
+#define ISREALPTR(r)	((((Ref)(r)) & 3) == 1)
+#endif
+
+#ifndef BOOL
+#define BOOL			int
+#endif
+
+#ifndef YES
+#define YES				1
+#endif
+
+#ifndef NO
+#define NO				0
+#endif
+
+#ifndef LONGALIGN
+#define LONGALIGN(n)	((((long) (n)) + 3) & ~3L)
+#endif
+
+#endif /* __NCTCOMPAT_H */
