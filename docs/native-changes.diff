-				p++;
-				utf8ch |= ((ch & 0x3F) << 6);
-				if (--numOfChars > 0 && (ch = *p) != kEndOfCharString)
-				{
-					p++;
-					*s++ = utf8ch | (ch & 0x3F);
-				}
-			}
+			if (ch != 0x0A)
+				*s++ = ch;
+			continue;
 		}
-		else if (chBits == 0xC0)
+		unsigned long cp;
+		int extra;
+		if ((ch & 0xE0) == 0xC0)		{ extra = 1; cp = ch & 0x1F; }
+		else if ((ch & 0xF0) == 0xE0)	{ extra = 2; cp = ch & 0x0F; }
+		else if ((ch & 0xF8) == 0xF0)	{ extra = 3; cp = ch & 0x07; }
+		else
 		{
-			utf8ch = (ch & 0x1F) << 6;
-			if (--numOfChars > 0 && (ch = *p) != kEndOfCharString)
-			{
-				p++;
-				*s++ = utf8ch | (ch & 0x3F);
-			}
+			*s++ = kUnmappable;			// stray continuation or invalid lead byte
+			continue;
 		}
-		else if (ch != 0x0A)
-			*s++ = ch;
+		while (extra > 0 && numOfChars > 0 && (*p & 0xC0) == 0x80)
