/*----------------------------------------------------------------------	Give the Extras icon a sensible name and icon.----------------------------------------------------------------------*/SetPartFrameSlot('text, kAppName);OpenResFile(home & "Resources");myIcons := MakeExtrasIcons([	{ unhilitedRsrcSpec:"extrasIcon4", hilitedRsrcSpec:"extrasIcon4hi", bitDepth:4 },	{ unhilitedRsrcSpec:"extrasIcon",  hilitedRsrcSpec:nil, bitDepth:1 }], "extrasIcon!", nil);foreach slot, value in myIcons do	SetPartFrameSlot(slot, value);CloseResFile();/*----------------------------------------------------------------------	Installation.	Patch Mail VÕs IMAP FSM.----------------------------------------------------------------------*/partData.installer := func(count)	begin	constant kWarning := "This Mail extension was not installed "								"because Mail V version 5.2 or later is not present.";	local mailV := GetRoot().(kMailAppSymbol);	if mailV = nil then		begin		if count < 10 then			AddDelayedSend(self, 'install, [count + 1], 1000)		else			GetRoot():Notify(kNotifyAlert, kAppName, kWarning);		return		end;	//	Do not install if Mail V v5.2 (or later) is not present.	local pkgRef;	if not (pkgRef := ObjectPkgRef(mailV._proto))	or GetPkgRefInfo(pkgRef).version < 520 then		GetRoot():Notify(kNotifyAlert, kAppName, kWarning);	else		begin		mailV.(EnsureInternal('IMAP_FSM)) := Clone(GetLayout("POP FSM"));		mailV.IMAP_FSM._proto := mailV._proto.IMAP_FSM		end	end;InstallScript := func(partFrame, removeFrame)beginpartFrame.partData:installer(1)end;/*----------------------------------------------------------------------	Removal.	Remove the patch applied to Mail VÕs IMAP FSM.----------------------------------------------------------------------*/RemoveScript := func(removeFrame)beginlocal mailV := GetRoot().(kMailAppSymbol);if mailV then	RemoveSlot(mailV, 'IMAP_FSM)end;