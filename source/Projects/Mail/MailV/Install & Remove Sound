/*----------------------------------------------------------------------	A sound icon template.	The following need to be patched at runtime:	o	package name in part directory (must be unique for Extras)	o	kPackageName (used for registering sound)	o	kAppName (used for finding sound and name displayed to user)----------------------------------------------------------------------*//*----------------------------------------------------------------------	Find the named sound in our Sounds soup.----------------------------------------------------------------------*/DefineGlobalConstant('kFindSoundFunc, func()	begin	local ssoup := GetUnionSoupAlways("Sounds:simple");	local q := ssoup:Query({indexPath:'userName, beginKey:kAppName, endKey:kAppName});	q:Entry()	end );/*----------------------------------------------------------------------	Give our sound a sensible name and icon.	Label it for the Sounds folder.----------------------------------------------------------------------*/SetPartFrameSlot('text, kAppName);OpenResFile(home & "Resources");sndIcons := MakeExtrasIcons(	[	{ unhilitedRsrcSpec: "snd icon4", hilitedRsrcSpec: "snd icon4hi", bitDepth: 4 },		{ unhilitedRsrcSpec: "snd icon",  hilitedRsrcSpec: nil, bitDepth: 1 } ],	"snd icon!", "snd iconhi!");foreach slot, value in sndIcons do	SetPartFrameSlot(slot, value);CloseResFile();SetPartFrameSlot('labels, 'Sounds);/*----------------------------------------------------------------------	Play the sound when the icon is tapped.----------------------------------------------------------------------*/SetPartFrameSlot('TapAction,  func()	begin	PlaySound(GetRegisteredSound(Intern(kPackageName)));	nil	end );/*----------------------------------------------------------------------	Installation.	Find our sound in the Sounds soup and register it.----------------------------------------------------------------------*/InstallScript := func(partFrame, removeFrame)beginlocal snd := call kFindSoundFunc with ();if snd then	RegSound(Intern(kPackageName), snd)end;/*----------------------------------------------------------------------	Removal.	Unregister our sound and remove it from the Sounds soup.----------------------------------------------------------------------*/RemoveScript := func(removeFrame)beginUnRegSound(Intern(kPackageName));local snd := call kFindSoundFunc with ();if snd then	EntryRemoveFromSoup(snd)end;