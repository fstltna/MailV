emeral port numberconstant kSMTPPortNumber :=    25;constant kPOPPortNumber :=    110;	//	for interest only - no longer usedconstant kIMAPPortNumber :=   143;//	Fixed sizesconstant kMaxSubjectLength := 100;constant kMaxInt :=     536870911;constant kVBOPageSize :=     1024;	//	size of input buffer •• try 2048? ••constant kVBOThreshold :=    2048;	//	size above which VBO is created for enclosureconstant kVBOModLimit :=       32;	//	limit of cached VBO 1K pagesconstant kMsgListInitSize :=  128;	// number of entries allocated for msg listconstant kMsgListIncr :=       32;//	Bits in text viewDef’s ioEditFlags slot to control menuLeftButtonsconstant kShowRecToggle :=	1 << 0;constant kShowKeyboard :=	1 << 1;//	Text Encodingconstant kEndOfUnicodeString := 0x0000;//	We need an error code to report when the store is full,//	ideally one that’s in the ROM_errorTable so it gets translated.//	The nearest one is "There is a problem reading from the host."constant kMsgTooLongErr := -42005;//	Have to handle packages and Newton data specially//	packages might come as://		application/octet-stream					standard//		application/x-newton							SM 3.0 and earlier; no longer supported//		application/x-newton-compatible-pkg		some websitespkgPreamble := MakeBinaryFromHex("7061636B61676530", 'binary);	//	package0DefineGlobalConstant('kPkgPreamble, pkgPreamble);//	EnRoute inet compatibilityconstant kxType := "\u0096\uewt";		//	"ñewt"xPreamble := MakeBinaryFromHex("A54E57460D0A1A0A"										 "0000000000000000", 'binary);	//	•NWFDefineGlobalConstant('kxPreamble, xPreamble);/*----------------------------------------------------------------------	Get icon PICTs for the transport and Tag button items.	Also the Sound package template.----------------------------------------------------------------------*/OpenResFile(home & "Resources");DefineGlobalConstant('kIcon_mail,          GetPictAsBits("email", nil));DefineGlobalConstant('kIcon_routeUnwrap,   GetPictAsBits("unwrap mail", nil));DefineGlobalConstant('kIcon_routeSelect,   GetPictAsBits("select all", nil));DefineGlobalConstant('kIcon_routeAsText,   GetPictAsBits("view as text", nil));DefineGlobalConstant('kIcon_routeDownload, GetPictAsBits("download mail", nil));DefineGlobalConstant('kIcon_routeDelete,   GetPictAsBits("deleted mail", nil));DefineGlobalConstant('kSoundPackage,	 GetNamedResource("pkg ", "sound", 'package));/*----------------------------------------------------------------------	Default text encoding - same as Mac OS X Mail default.	We include ISO 8859-1 as an alternate charset.	windows-1252 is a superset of ISO 8859-1.----------------------------------------------------------------------*/DefineGlobalConstant('kLatin1TextEncoding, {	symbol: '|windows-1252|,	name: "Western (Latin 1)",	alternate: '[|ISO-8859-1|],	toUnicode: GetNamedResource("UniC", "From:windows-1252", 'UniC),	fromUnicode: GetNamedResource("UniC", "To:windows-1252", 'UniC),	mimeEncoding: '|quoted-printable|,	version: 1 } );/*----------------------------------------------------------------------	UTF-8 text encoding,----------------------------------------------------------------------*/DefineGlobalConstant('kUTF8TextEncoding, {	symbol: '|UTF-8|,	name: "Unicode (UTF-8)",	toUnicode: GetNamedResource("UniC", "From:UTF-8", 'UniC),	fromUnicode: GetNamedResource("UniC", "To:UTF-8", 'UniC),	mimeEncoding: '|quoted-printable|,	version: 1 } );CloseResFile();/*----------------------------------------------------------------------	G l o b a l   F u n c t i o n s------------------------------------------------------------------------	Test for Newton 2.1	The protoTransport:DeleteRemoteItems function was added in 2.1	so we test for the existence of this.----------------------------------------------------------------------*/DefineGlobalConstant('kIsNewton21Func,	func() protoTransport:DeleteRemoteItems exists );/*----------------------------------------------------------------------	Determine whether a character is a digit 0..9.----------------------------------------------------------------------*/DefineGlobalConstant('kIsDigitFunc,	func(ch) ch >= $0 and ch <= $9 );/*----------------------------------------------------------------------	Ensure all slot _symbols_ in a frame are internal	(but not the values).----------------------------------------------------------------------*/DefineGlobalConstant('kEnsureInternalFunc,	func(frame)	begin	local internal := EnsureInternal({});	foreach slot, val in frame do		internal.(EnsureInternal(slot)) := val;	internal	end );/*----------------------------------------------------------------------	Patch a view by inserting slots at the top of the _proto chain.----------------------------------------------------------------------*/DefineGlobalConstant('kPatchProtoFunc,	func(base, patches)	if base then		begin		patches.tag := kAppSymbol;		patches._proto := base._proto;		base._proto := call kEnsureInternalFunc with (patches)		end );/*----------------------------------------------------------------------	Remove the patches we applied.----------------------------------------------------------------------*/DefineGlobalConstant('kRemoveProtoPatchFunc,	func(base)	if base then		begin		local this;		while this := base._proto do			if this.tag = kAppSymbol then				break base.(EnsureInternal('_proto)) := this._proto			else				base := this		end );/*----------------------------------------------------------------------	Check data signature.----------------------------------------------------------------------*/DefineGlobalConstant('kCharEqualFunc,	func(data, offset, str)	begin	local strLength := StrLen(str);	if Length(data) >= offset + strLength then		begin		for i := 0 to strLength - 1 do			if ExtractChar(data, offset + i) <> str[i] then				return nil;		true		end	end );/*----------------------------------------------------------------------	Create a message size string.----------------------------------------------------------------------*/DefineGlobalConstant('kMakeSizeStrFunc,	func(size) if size < 1024	then SPrintObject(size)										else FormattedNumberStr(size/1024, "%.1fK") );/*----------------------------------------------------------------------	If string is empty, make it "untitled".----------------------------------------------------------------------*/DefineGlobalConstant('kEnsureTitleFunc,	func(str) if StrFilled(str) then str										 else LocObj("untitled", 'routing.untitled) );/*----------------------------------------------------------------------	Create a text body frame.----------------------------------------------------------------------*/DefineGlobalConstant('kMakeTextBodyFunc,	func(str) { class: 'text, text: str } );/*----------------------------------------------------------------------	Since this is not an application/form part, we need a partframe	for the main layout to stuff itself into.----------------------------------------------------------------------*/partData := {	author: "Simon Bell",					copyright: kCopyright };