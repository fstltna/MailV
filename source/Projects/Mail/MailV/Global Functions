/*----------------------------------------------------------------------	Global Functions  (2026 reconstruction)	Simon Bell's original "Global Functions" file was not included in the	published MailV source. This replacement defines the build-time	constants the rest of the project uses that no other file defines:		kRegisterTextEncodingDefFunc		kUnRegisterTextEncodingDefFunc		kBuildTextEncodingPopupFunc		GIF		(stub: the GIF.ntkc native module is also missing)	Text encodings are kept in the global variable TextEncodings, a frame	keyed by MIME charset symbol. The native SM module looks charsets up	there (GetGlobalVar('TextEncodings).(charset)), so the layout must	stay the same.----------------------------------------------------------------------*///	Register a text encoding definition frame://		{ symbol, name, alternate, toUnicode, fromUnicode, mimeEncoding, version }//	A newer (or equal) version replaces an existing one.DefineGlobalConstant('kRegisterTextEncodingDefFunc,func(def)begin	if not def or not def.symbol then return nil;	local reg := GetGlobalVar('TextEncodings);	if not reg then		begin		DefGlobalVar(EnsureInternal('TextEncodings), {});		reg := GetGlobalVar('TextEncodings)		end;	local old := reg.(def.symbol);	if old and old.version and def.version and old.version > def.version then		return nil;	reg.(EnsureInternal(def.symbol)) := def;	if def.alternate then		foreach sym in def.alternate do			reg.(EnsureInternal(sym)) := def;	trueend);//	Remove a text encoding (by charset symbol) from the registry.DefineGlobalConstant('kUnRegisterTextEncodingDefFunc,func(sym)begin	local reg := GetGlobalVar('TextEncodings);	if reg and sym and HasSlot(reg, sym) then		RemoveSlot(reg, sym);	nilend);//	Build the labelCommands popup for the Text encoding preference://	one { item: name, symbol: charset } per registered encoding,//	alternates listed once, sorted by name.DefineGlobalConstant('kBuildTextEncodingPopupFunc,func()begin	local popup := [];	local seen := [];	local reg := GetGlobalVar('TextEncodings);	if reg then		foreach def in reg do			if IsFrame(def) and def.symbol and not LSearch(seen, def.symbol, 0, '|=|, nil) then				begin				AddArraySlot(seen, def.symbol);				AddArraySlot(popup, { item: if def.name then def.name else SPrintObject(def.symbol),											 symbol: def.symbol })				end;	if Length(popup) = 0 then		AddArraySlot(popup, { item: "Western (Latin 1)", symbol: '|windows-1252| });	Sort(popup, '|str<|, 'item);	popupend);//	GIF stub. The GIF.ntkc native module (Simon's GIF encoder/decoder)//	isn't in the published source, so sending a note as a GIF image is//	disabled in this build. Everything else is unaffected; GIF.Decode is//	already commented out in vCardDecoderDef.DefineGlobalConstant('GIF, {	Encode: func(bitmap, store)		Throw('|evt.ex.msg|, "Sending as a GIF image isn't available in this build of Mail V."),	Decode: func(data, store)		nil});