/*----------------------------------------------------------------------	Global Functions  (2026 reconstruction)	Simon Bell's original "Global Functions" file was not included in the	published MailV source. This replacement defines the build-time	constants the rest of the project uses that no other file defines.	Text encodings are kept in the global variable TextEncodings, a frame	keyed by MIME charset symbol. The native SM module looks charsets up	there (GetGlobalVar('TextEncodings).(charset)), so the layout must	stay the same.----------------------------------------------------------------------*/DefineGlobalConstant('kRegisterTextEncodingDefFunc,func(def)begin	if not def or not def.symbol then return nil;	local reg := GetGlobalVar('TextEncodings);	if not reg then		begin		DefGlobalVar(EnsureInternal('TextEncodings), {});		reg := GetGlobalVar('TextEncodings)		end;	local old := reg.(def.symbol);	if old and old.version and def.version and old.version > def.version then		return nil;	reg.(EnsureInternal(def.symbol)) := def;	if def.alternate then		foreach sym in def.alternate do			reg.(EnsureInternal(sym)) := def;	trueend);DefineGlobalConstant('kUnRegisterTextEncodingDefFunc,func(sym)begin	local reg := GetGlobalVar('TextEncodings);	if reg and sym and HasSlot(reg, sym) then		RemoveSlot(reg, sym);	nilend);DefineGlobalConstant('kBuildTextEncodingPopupFunc,func()begin	local popup := [];	local seen := [];	local reg := GetGlobalVar('TextEncodings);	if reg then		foreach def in reg do			if IsFrame(def) and def.symbol and not LSearch(seen, def.symbol, 0, '|=|, nil) then				begin				AddArraySlot(seen, def.symbol);				AddArraySlot(popup, { item: if def.name then def.name else SPrintObject(def.symbol),											 symbol: def.symbol })				end;	if Length(popup) = 0 then		AddArraySlot(popup, { item: "Western (Latin 1)", symbol: '|windows-1252| });	Sort(popup, '|str<|, 'item);	popupend);//	GIF stub - the GIF.ntkc native module was not published, so sending a//	note as a GIF image is disabled in this build.DefineGlobalConstant('GIF, {	Encode: func(bitmap, store)		Throw('|evt.ex.msg|, "Sending as a GIF image isn't available in this build of Mail V."),	Decode: func(data, store)		nil});//	NIE transport service (value as compiled into Simon's 5.2.1 package)constant kTCP := 1;//	Endpoint event codes and comm error (Apple Transport.h / CommErrors.h)constant kEventToolSpecific := 1;		//	T_SPECEVTconstant kEventDisconnect := 2;			//	T_DISCONNECTconstant kEventRelease := 3;			//	T_ORDRELconstant kCommErrNotConnected := -16009;	//	ERRBASE_COMMTOOL - 9