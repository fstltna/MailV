/*----------------------------------------------------------------------	Give our transport a sensible name and icon.----------------------------------------------------------------------*/SetPartFrameSlot('text, kAppName);OpenResFile(home & "Resources");myIcons := MakeExtrasIcons([	{ unhilitedRsrcSpec:"extrasIcon4", hilitedRsrcSpec:"extrasIcon4hi", bitDepth:4 },	{ unhilitedRsrcSpec:"extrasIcon",  hilitedRsrcSpec:nil, bitDepth:1 }], "extrasIcon!", nil);foreach slot, value in myIcons do	SetPartFrameSlot(slot, value);CloseResFile();/*----------------------------------------------------------------------	Installation	Register our transport.	RegTransport() calls the part’s InstallScript	which registers our viewDefs (amongst other things).----------------------------------------------------------------------*/InstallScript := func(partFrame, removeFrame)beginlocal theTransport := partFrame.partData.(kAppSymbol);RegTransport(kAppSymbol, theTransport)end;/*----------------------------------------------------------------------	Removal	Unregister our transport and viewDefs.----------------------------------------------------------------------*/RemoveScript := func(removeFrame)beginlocal theTransport := GetRoot().(kAppSymbol);theTransport:RemoveScript();UnregTransport(kAppSymbol)end;/*----------------------------------------------------------------------	Deletion	Delete any Mail setups from all owner cards, and our prefs.----------------------------------------------------------------------*//*if not kDebugOn thenSetPartFrameSlot('DeletionScript, func()beginforeach alias in GetUserConfig('personae) do	begin	local persona := ResolveEntryAlias(alias);	if persona.owner.(kAppSymbol) then		begin		RemoveSlot(persona.owner, kAppSymbol);		EntryFlushXmit(persona, kAppSymbol)		end	end;foreach alias in GetUserConfig('emporia) do	begin	local emporium := ResolveEntryAlias(alias);	if emporium.(kAppSymbol) then		begin		Remove